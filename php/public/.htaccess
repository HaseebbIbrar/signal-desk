# Signal Desk (PHP) on 20i: upload this folder's contents to the subdomain's document root.
DirectoryIndex index.php
Options -Indexes -MultiViews
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1. Force HTTPS (20i may terminate TLS in front of Apache, hence the X-Forwarded-Proto check).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # 2. Never serve the private folder (layout B), dotfiles, or the locator include.
  RewriteRule ^_private(/|$) - [F,L]
  RewriteRule (^|/)\. - [F,L]
  RewriteRule ^locate\.inc\.php$ - [F,L]

  # 3. Public entry points and static assets only.
  RewriteRule ^assets/[A-Za-z0-9._-]+\.(css|js|svg|png|ico|woff2?)$ - [L]
  RewriteRule ^(index|health)\.php$ - [L]

  # 4. Any other real file is refused; everything else goes to the front controller.
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [F,L]
  RewriteRule ^ index.php [L,QSA]
</IfModule>

# Belt and braces if mod_rewrite is off: only the two entry points may run as PHP.
<FilesMatch "\.(php|phtml|phar|inc|json|log|lock|md|txt|example|bak|sql|ini|sh|tmp)$">
  Require all denied
</FilesMatch>
<FilesMatch "^(index|health)\.php$">
  Require all granted
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always unset X-Powered-By
</IfModule>
