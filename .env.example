# ─────────────────────────────────────────────────────────────────────────────
# Signal Desk configuration. Copy to .env.local for local work; set the same
# variables in Vercel → Project → Settings → Environment Variables.
# None of these are exposed to the browser (no NEXT_PUBLIC_ variables).
# ─────────────────────────────────────────────────────────────────────────────

# production = writes to the real master workbook (GRAPH_MASTER_ITEM_ID).
# development = writes to the COPY (GRAPH_DEV_ITEM_ID); refuses to start if it equals the master.
APP_ENV=development

# graph = live Microsoft Graph. mock = in-memory fake data (local UI work; refused in production).
WORKBOOK_BACKEND=graph

# Public origin of the app, used for the CSRF Origin check. Set it in production.
APP_ORIGIN=https://signals.swooscale.com

# ── Entra ID app registration (client credentials) ──────────────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# ── Workbook location (resolve with `npm run find-ids`; never guess) ─────────
# Only used by the find-ids script and for reference; the app needs drive + item ids.
SHAREPOINT_HOST=swoosearch.sharepoint.com
SHAREPOINT_SITE_PATH=/sites/SwooscaleHub
GRAPH_SITE_ID=
GRAPH_DRIVE_ID=
# "SwooScale Master Data.xlsx" (the real one)
GRAPH_MASTER_ITEM_ID=
# A COPY of the workbook for development/testing (required when APP_ENV=development)
GRAPH_DEV_ITEM_ID=

# ── Login ───────────────────────────────────────────────────────────────────
# At least 32 random characters, e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# ";"-separated entries of  email|Display Name|base64(bcrypt hash)  — create with `npm run hash-password`
AUTH_USERS=

# ── Optional: shared login rate-limit store across Vercel instances ──────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
