{
  "name": "signal-desk",
  "version": "1.0.0",
  "private": true,
  "description": "SwooScale Signal Desk: review daily job signals and record decision makers, backed live by the SharePoint master workbook.",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/sg-prepare-build.cjs && next build && node scripts/sg-verify-build.cjs",
    "start": "next start",
    "test": "vitest run",
    "test:dev-copy": "node --env-file=.env.local node_modules/vitest/vitest.mjs run --config vitest.integration.mts",
    "typecheck": "tsc --noEmit",
    "hash-password": "node scripts/hash-password.mjs",
    "find-ids": "node --env-file=.env.local scripts/find-graph-ids.mjs",
    "snapshot": "node scripts/make-src-snapshot.cjs"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  }
}
